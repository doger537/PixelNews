DATABASE_URL=postgresql+psycopg://news:news@postgres:5432/news_ai_filter
REDIS_URL=redis://redis:6379/0

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=
TELEGRAM_SESSION_NAME=news_ai_filter

MEDIA_STORAGE_PATH=data/processed/media
PARSER_LIMIT_PER_SOURCE=30
PARSER_SCHEDULER_ENABLED=false
PARSER_SCHEDULE_MINUTES=15
PARSER_ENGINE=httpx_selectolax
APP_TIMEZONE=Europe/Moscow
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=250
MAX_MEDIA_FILE_SIZE_MB=8
PARSER_RUN_MIN_INTERVAL_SECONDS=10
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BACKGROUND_INGEST_ENABLED=false
BACKGROUND_INGEST_INTERVAL_SECONDS=60
BACKGROUND_PROCESS_ENABLED=false
BACKGROUND_PROCESS_INTERVAL_SECONDS=10
BACKGROUND_PROCESS_BATCH_SIZE=50

AI_FILTER_PROVIDER=rule_based
AI_FILTER_API_KEY=
AI_FILTER_BASE_URL=http://127.0.0.1:11434
AI_FILTER_MODEL=llama3.1
AI_FILTER_TIMEOUT_SECONDS=8
AI_PERSONALIZATION_ENABLED=false
AI_PERSONALIZATION_BATCH_SIZE=30
AI_POST_EDITOR_ENABLED=false
AI_POST_EDITOR_BACKGROUND_ENABLED=false
AI_POST_EDITOR_BACKGROUND_INTERVAL_SECONDS=60
AI_POST_EDITOR_BACKGROUND_BATCH_SIZE=5
AI_POST_EDITOR_SUMMARY_SIZES=short

TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=google
TRANSLATION_TIMEOUT_SECONDS=8
TRANSLATION_ON_READ_ENABLED=false

CACHE_SERVICES_ENABLED=false
FEED_CACHE_URL=http://127.0.0.1:8011
USER_CACHE_URL=http://127.0.0.1:8012
FANOUT_SERVICE_URL=http://127.0.0.1:8013
SERVICE_CACHE_TTL_SECONDS=180
QUEUE_DIR=data/queues
LOAD_BALANCER_BACKENDS=http://127.0.0.1:8001
SERVICE_REQUEST_TIMEOUT_SECONDS=3
