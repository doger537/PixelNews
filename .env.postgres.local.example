DATABASE_URL=postgresql+psycopg://pixelnews:pixelnews@127.0.0.1:5432/pixelnews
REDIS_URL=redis://localhost:6379/0

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=
TELEGRAM_SESSION_NAME=news_ai_filter

MEDIA_STORAGE_PATH=data/processed/media
PARSER_LIMIT_PER_SOURCE=30
PARSER_SCHEDULER_ENABLED=true
PARSER_SCHEDULE_MINUTES=15
PARSER_ENGINE=httpx_selectolax
APP_TIMEZONE=Europe/Moscow
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=250
MAX_MEDIA_FILE_SIZE_MB=8
PARSER_RUN_MIN_INTERVAL_SECONDS=10
PARSER_RUN_TIMEOUT_SECONDS=240

CAPTCHA_PROVIDER=local
BACKGROUND_INGEST_ENABLED=false
BACKGROUND_PROCESS_ENABLED=true
BACKGROUND_PROCESS_INTERVAL_SECONDS=10
BACKGROUND_PROCESS_BATCH_SIZE=10

AI_FILTER_PROVIDER=ollama
AI_FILTER_API_KEY=
AI_FILTER_BASE_URL=http://127.0.0.1:11434
AI_FILTER_MODEL=llama3.1:latest
AI_FILTER_TIMEOUT_SECONDS=60
AI_PERSONALIZATION_ENABLED=false
AI_POST_EDITOR_ENABLED=false
AI_POST_EDITOR_BACKGROUND_ENABLED=true
AI_POST_EDITOR_BACKGROUND_INTERVAL_SECONDS=90
AI_POST_EDITOR_BACKGROUND_BATCH_SIZE=1
AI_POST_EDITOR_SUMMARY_SIZES=short

CACHE_SERVICES_ENABLED=true
FEED_CACHE_URL=http://127.0.0.1:8011
USER_CACHE_URL=http://127.0.0.1:8012
FANOUT_SERVICE_URL=http://127.0.0.1:8013
SERVICE_CACHE_TTL_SECONDS=180
QUEUE_DIR=data/queues
LOAD_BALANCER_BACKENDS=http://127.0.0.1:8001,http://127.0.0.1:8002
