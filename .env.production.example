# Database
POSTGRES_DB=pixelnews
POSTGRES_USER=pixelnews
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://pixelnews:change_me@postgres:5432/pixelnews

# Redis/cache/message queue
REDIS_URL=redis://redis:6379/0
CACHE_SERVICES_ENABLED=true
FEED_CACHE_URL=http://feed-cache:8011
USER_CACHE_URL=http://user-cache:8012
FANOUT_SERVICE_URL=http://fanout:8013
SERVICE_CACHE_TTL_SECONDS=180
QUEUE_DIR=/app/data/queues

# Public URLs and auth
SECRET_KEY=change_me_to_a_long_random_string
BACKEND_URL=http://backend:8000
FRONTEND_URL=https://example.com

# Captcha. Replace test keys with production Cloudflare Turnstile keys before public launch.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=
TELEGRAM_SESSION_NAME=/app/sessions/pixelnews
TELEGRAM_SESSION_STRING=

# Storage
MEDIA_STORAGE_PATH=/app/media
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=250
MAX_MEDIA_SIZE_MB=10

# Parser runs only in the scheduler container in production.
PARSER_ENGINE=httpx_selectolax
PARSER_LIMIT_PER_SOURCE=50
PARSER_DEFAULT_PERIOD=last_24h
PARSER_SCHEDULE_MINUTES=15
PARSER_RUN_MIN_INTERVAL_SECONDS=10
PARSER_RUN_TIMEOUT_SECONDS=240
BACKGROUND_INGEST_ENABLED=false

# Article processing runs only in article-worker.
BACKGROUND_PROCESS_ENABLED=false
BACKGROUND_PROCESS_INTERVAL_SECONDS=10
BACKGROUND_PROCESS_BATCH_SIZE=50

# AI/Ollama never blocks feed opening. It warms edited text only in the background.
AI_FILTER_PROVIDER=ollama
AI_FILTER_BASE_URL=http://host.docker.internal:11434
AI_FILTER_MODEL=llama3.1
AI_FILTER_TIMEOUT_SECONDS=8
AI_POST_EDITOR_ENABLED=false
AI_POST_EDITOR_BACKGROUND_ENABLED=true
AI_POST_EDITOR_BACKGROUND_INTERVAL_SECONDS=60
AI_POST_EDITOR_BACKGROUND_BATCH_SIZE=5
AI_POST_EDITOR_SUMMARY_SIZES=short

# Optional translation
TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=google
TRANSLATION_ON_READ_ENABLED=false
